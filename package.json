{
  "name": "@sudobility/consumables_client",
  "version": "0.0.37",
  "description": "Cross-platform consumable credits client with RevenueCat adapter pattern",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./adapter/web": {
      "import": "./dist/adapters/revenuecat-web.js",
      "types": "./dist/adapters/revenuecat-web.d.ts"
    },
    "./adapter/rn": {
      "import": "./dist/adapters/revenuecat-rn.js",
      "types": "./dist/adapters/revenuecat-rn.d.ts"
    }
  },
  "files": [
    "dist",
    "CLAUDE.md"
  ],
  "scripts": {
    "build": "bunx tsc -p tsconfig.build.json",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx eslint src",
    "lint:fix": "bunx eslint src --fix",
    "format": "bunx prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "verify": "bun run typecheck && bun run lint && bun run test:unit && bun run build",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "@sudobility/types": "^1.9.76",
    "react": "^18.0.0 || ^19.0.0",
    "@revenuecat/purchases-js": "^1.0.0",
    "react-native-purchases": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "@revenuecat/purchases-js": {
      "optional": true
    },
    "react-native-purchases": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@revenuecat/purchases-js": "~1.73.1",
    "@sudobility/types": "^1.9.76",
    "@types/bun": "~1.4.4",
    "@types/node": "~26.6.5",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "eslint": "~10.13.0",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-prettier": "~5.5.7",
    "prettier": "~3.9.10",
    "typescript": "~6.0.3",
    "vitest": "~4.1.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "BUSL-1.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/consumables_client.git"
  }
}
